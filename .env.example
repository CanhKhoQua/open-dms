# ---- Database ----
# Default: SQLite (zero-config, no server). Clone & run works out of the box.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
#
# Hosted / Postgres (e.g. Vercel + Neon): set both of these instead:
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Demo controls ----
# Allow POST /api/seed (and the "Reset demo data" button) to reseed the DB.
# Enable on a throwaway demo; keep off in real deployments.
ALLOW_DEMO_SEED="true"

# ---- ERP source of data ----
# mock = built-in demo data (default) | csv = ./data/*.csv | misa = stub seam
ERP_ADAPTER="mock"
MISA_DB_URL=""

# ---- Maps ----
NEXT_PUBLIC_MAP_PROVIDER="osm"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---- Web Push (optional; blank = disabled) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ---- Database ----
# Postgres (default, via docker-compose):
DATABASE_URL="postgresql://opendms:opendms@localhost:5432/opendms?schema=public"
# To run WITHOUT Docker, switch schema.prisma provider to "sqlite" and use:
# DATABASE_URL="file:./dev.db"

# ---- ERP source of data ----
# mock  = built-in demo data (default, no external system)
# csv   = import from files in ./data/*.csv
# misa  = MISA SQL Server plugin (stub in this public build)
ERP_ADAPTER="mock"

# MISA plugin connection (only used when ERP_ADAPTER=misa; left blank in public build)
MISA_DB_URL=""

# ---- Maps ----
# Defaults to OpenStreetMap tiles (no key). Set a provider key to switch.
NEXT_PUBLIC_MAP_PROVIDER="osm"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---- Web Push (optional) ----
# Leave blank to disable push notifications entirely.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

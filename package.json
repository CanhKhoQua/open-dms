{
  "name": "open-dms",
  "version": "0.1.0",
  "private": true,
  "description": "Open, ERP-agnostic Distribution Management System (field sales, GPS check-in, order taking, self-contained accounts receivable).",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/set-provider.mjs && prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "node scripts/set-provider.mjs && prisma generate",
    "predev": "node scripts/set-provider.mjs && prisma generate",
    "db:push": "node scripts/set-provider.mjs && prisma db push",
    "db:reset": "node scripts/set-provider.mjs && prisma db push --force-reset && npm run seed",
    "db:studio": "prisma studio",
    "smoke": "tsx scripts/smoke-logic.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
